# ============================================================
# 本文件是后端「唯一需要按本机修改」的配置入口。
# 复制为 .env 后按需填写；业务代码会覆盖 JSON/脚本里的本机路径。
#   copy .env.example .env
# ============================================================

# mock=演示闭环（不调 SAGA/QGIS/InVEST）；real=真实流程
PIPELINE_MODE=mock

# LLM（OpenAI 兼容；推荐 DeepSeek）。可留空 Key，则走规则兜底（偏安吉）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 相对 backend/ 的路径一般不用改
REGION_REGISTRY_DIR=regions
RUNS_DIR=runs
DB_PATH=app.db
DATA_CATALOG=data/catalog.json

# 数据/脚本根目录（可选）。不设则自动推断；CLCD、县级.shp 找不到时再设绝对路径
# PROJECT_ROOT=

# ---------- 仅 PIPELINE_MODE=real 时必填（按本机安装位置改）----------
# SAGA GIS 的 saga_cmd.exe
SAGA_CMD=C:\Program Files\SAGA-GIS\saga_cmd.exe

# QGIS 自带的 Python 启动脚本（指北针资源也会从此路径推导）
QGIS_PYTHON_BAT=C:\Program Files\QGIS 3.34.0\bin\python-qgis-ltr.bat

# InVEST 工作目录（可写；不存在会自动创建）。可相对 backend/，也可绝对路径
INVEST_WORK_DIR=runs/invest_work

# 跑 InVEST 的 Python（需已 pip install natcap.invest）。留空=当前解释器
PYTHON_EXE=

# 可选：生境质量配置模板；留空则用 invest/config_anji_hq.json
INVEST_CONFIG=

HOST=127.0.0.1
PORT=8000
