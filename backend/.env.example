# mock=演示闭环；real=调用 SAGA/InVEST 真实流程
PIPELINE_MODE=mock

# LLM（OpenAI 兼容；推荐 DeepSeek）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

REGION_REGISTRY_DIR=regions
RUNS_DIR=runs
DB_PATH=app.db
DATA_CATALOG=data/catalog.json

# SAGA / Python / InVEST / QGIS（仅 PIPELINE_MODE=real 时需要，按本机路径修改）
SAGA_CMD=D:\download\SAGA 9.12.0\saga_cmd.exe
PYTHON_EXE=
QGIS_PYTHON_BAT=D:\download\QGIS\bin\python-qgis-ltr.bat
INVEST_WORK_DIR=D:/invest
# 可选：默认自动使用 PROJECT_ROOT/invest/config_anji_hq.json
INVEST_CONFIG=

HOST=127.0.0.1
PORT=8000
